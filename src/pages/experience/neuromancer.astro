---
import { Image } from "astro:assets";
import Layout from "../../layouts/Layout.astro";
import ProjectHeader from "../../components/experience/ProjectHeader.astro";
import ProjectBody from "../../components/experience/ProjectBody.astro";
import ProjectMeta from "../../components/experience/ProjectMeta.astro";
import MetaItem from "../../components/experience/MetaItem.astro";
import ProjectProse from "../../components/experience/ProjectProse.astro";
import ProjectLinks from "../../components/experience/ProjectLinks.astro";
import ProjectLink from "../../components/experience/ProjectLink.astro";
import Shot from "../../components/experience/Shot.astro";

import type { Metadata } from "../../types";

import banner from "../../assets/img/experience/neuromancer.webp";
import gameplayOne from "../../assets/img/experience/neuromancer/gameplay1.webp";
import gameplayTwo from "../../assets/img/experience/neuromancer/gameplay2.webp";

const meta: Metadata = {
  title: "Neuromancer",
  description:
    "Neuromancer is a 2D narrative based therapy simulator where you play as an evil wizard trying to help your monstrous minions navigate their own complex issues.",
};
---

<Layout {meta}>
  <div class="page-wrap">
    <ProjectHeader title="Neuromancer" subtitle="Open Alpha USC" />
    <div class="mt-8 border-2 border-ink">
      <Image alt={"Neuromancer logo"} src={banner} loading="eager" class="w-full" />
    </div>

    <ProjectBody>
      <ProjectMeta slot="meta">
        <MetaItem label="Role">Gameplay Programmer</MetaItem>
        <MetaItem label="Dates">Sept. 2025 – Jan. 2026</MetaItem>
        <MetaItem label="Technologies">Unity &amp; C#</MetaItem>
        <MetaItem label="Team size">50+ team members</MetaItem>
        <ProjectLinks slot="links">
          <ProjectLink href="https://open-alpha-usc.itch.io/neuromancer" icon="simple-icons:itchdotio">
            Play on itch.io
          </ProjectLink>
        </ProjectLinks>
      </ProjectMeta>

      <ProjectProse>
        <h2>Gameplay</h2>

        <p class="lead">
          Neuromancer is a 2D narrative based therapy simulator where you play as an evil wizard trying to help your
          monstrous minions navigate their own complex issues.
        </p>

        <Shot>
          <Image alt={"Gameplay of Neuromancer"} src={gameplayOne} />
        </Shot>
        <Shot>
          <Image alt={"Gameplay of Neuromancer"} src={gameplayTwo} />
        </Shot>

        <h2>My role</h2>
        <p>
          As a Gameplay Programmer, I worked on the live-updating dialogue system as well as the transcribing scroll
          that stores conversation history so the player can reference it later. I also implemented the potion crafting
          system that allows the player to combine different ingredients to create potions that cure specific ailments.
        </p>
      </ProjectProse>
    </ProjectBody>
  </div>
</Layout>
