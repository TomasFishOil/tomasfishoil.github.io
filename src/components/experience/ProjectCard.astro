---
import { Icon } from "astro-icon/components";
import type { ImageMetadata } from "astro";
import ProjectBanner from "./ProjectBanner.astro";

interface Props {
  href: string;
  title: string;
  banner?: ImageMetadata;
}

const { href, title, banner } = Astro.props;
---

<li class="w-full max-w-md sm:w-[calc(50%-0.75rem)] sm:max-w-none">
  <a href={href} class="group block border-2 border-ink bg-paper-light/60 transition hover:scale-105">
    <ProjectBanner src={banner} ratio={2} width={480} />
    <div class="flex items-center justify-between gap-3 border-t-2 border-ink px-4 py-3 group-hover:bg-ink group-hover:text-paper-light">
      <h3 class="text-lg leading-tight wrap-break-word">{title}</h3>
      <Icon name="lucide:arrow-right" class="size-5 shrink-0" />
    </div>
  </a>
</li>
