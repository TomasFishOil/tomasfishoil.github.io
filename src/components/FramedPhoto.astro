---
import { Image } from "astro:assets";
import headshot from "../assets/img/headshot.webp";
import frame from "../assets/img/frame.svg";
import frameSvg from "../assets/img/frame.svg?raw";
import { frameMask } from "../lib/frameMask.ts";

interface Props {
  alt?: string;
}

const { alt = "" } = Astro.props;

// Display width (px) at 1x; the photo is cropped to the frame's proportions.
const width = 280;
const height = Math.round((width * frame.height) / frame.width);

// 2x the display width, so the mask edges stay crisp on high-DPI screens.
const mask = await frameMask(frameSvg, frame.width, width * 2);
const style = [`aspect-ratio: ${frame.width} / ${frame.height}`, mask && `--frame-mask: url(${mask})`]
  .filter(Boolean)
  .join(";");
---

<figure class="framed" style={style}>
  <div class="framed__clip">
    <Image
      class="framed__photo"
      src={headshot}
      alt={alt}
      width={width}
      height={height}
      densities={[1, 2]}
      fit="cover"
    />
  </div>
  <img
    class="framed__frame"
    src={frame.src}
    width={frame.width}
    height={frame.height}
    alt=""
    aria-hidden="true"
    decoding="async"
  />
</figure>

<style>
  .framed {
    position: relative;
    /* definite width: the children are absolutely positioned, so the box can't size to content */
    width: 17.5rem;
    max-width: 100%;
    margin: 0;
    line-height: 0;
  }

  .framed__clip,
  .framed__frame {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  /* cut the photo to the frame's silhouette */
  .framed__clip {
    -webkit-mask-image: var(--frame-mask, none);
    mask-image: var(--frame-mask, none);
    -webkit-mask-size: 100% 100%;
    mask-size: 100% 100%;
    -webkit-mask-repeat: no-repeat;
    mask-repeat: no-repeat;
  }

  .framed__photo {
    display: block;
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
  }

  .framed__frame {
    display: block;
    max-width: none;
    pointer-events: none;
    user-select: none;
  }
</style>
