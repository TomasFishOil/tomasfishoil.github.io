---
import { Image } from "astro:assets";
import Layout from "../../layouts/Layout.astro";
import ProjectHeader from "../../components/experience/ProjectHeader.astro";
import ProjectBody from "../../components/experience/ProjectBody.astro";
import ProjectMeta from "../../components/experience/ProjectMeta.astro";
import MetaItem from "../../components/experience/MetaItem.astro";
import ProjectProse from "../../components/experience/ProjectProse.astro";
import ProjectLinks from "../../components/experience/ProjectLinks.astro";
import ProjectLink from "../../components/experience/ProjectLink.astro";
import Shot from "../../components/experience/Shot.astro";

import type { Metadata } from "../../types";

import banner from "../../assets/img/experience/large-language-mimic.webp";
import gameplayChat from "../../assets/img/experience/large-language-mimic/chat.webp";
import gameplayMinigame from "../../assets/img/experience/large-language-mimic/minigame.webp";

const meta: Metadata = {
  title: "Large Language Mimic",
  description:
    "Large Language Mimic is a 2D political satire narrative game where you play as an AI chatbot tasked with helping your local senator through minigame style tasks.",
};
---

<Layout {meta}>
  <div class="page-wrap">
    <ProjectHeader title="Large Language Mimic" subtitle="Open Alpha USC" />
    <div class="mt-8 border-2 border-ink">
      <Image alt={"Large Language Mimic logo"} src={banner} loading="eager" />
    </div>

    <ProjectBody>
      <ProjectMeta slot="meta">
        <MetaItem label="Role">Lead Programmer</MetaItem>
        <MetaItem label="Dates">January – June 2026</MetaItem>
        <MetaItem label="Technologies">Unity &amp; C#</MetaItem>
        <MetaItem label="Team size">60 team members</MetaItem>
        <ProjectLinks slot="links">
          <ProjectLink href="https://open-alpha-usc.itch.io/large-language-mimic" icon="simple-icons:itchdotio">
            Play on itch.io
          </ProjectLink>
        </ProjectLinks>
      </ProjectMeta>

      <ProjectProse>
        <h2>Gameplay</h2>

        <p class="lead">
          Large Language Mimic is a 2D political satire narrative game where you play as an AI chatbot tasked with
          helping your local senator through minigame style tasks.
        </p>

        <Shot>
          <Image alt={"Chat portion of Large Language Mimic"} src={gameplayChat} />
        </Shot>
        <Shot>
          <Image alt={"Example of a minigame in Large Language Mimic"} src={gameplayMinigame} />
        </Shot>

        <h2>My role</h2>
        <p>
          As a Lead Programmer, I ran sprints and stand-ups for our programming team, creating tasks after communicating
          with the design team on specifics for implementation. I built the core <b>minigame framework</b> that allowed
          programmers to work on their games individually as well as the game's <b>"Campaign Planning" minigame</b>.
          Finally, I managed the game's GitHub <b>version control</b>, merging branches and approving pull requests
          every week.
        </p>
      </ProjectProse>
    </ProjectBody>
  </div>
</Layout>
