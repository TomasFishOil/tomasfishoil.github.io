---
import { Image } from "astro:assets";
import Layout from "../../layouts/Layout.astro";
import ProjectHeader from "../../components/experience/ProjectHeader.astro";
import ProjectBody from "../../components/experience/ProjectBody.astro";
import ProjectMeta from "../../components/experience/ProjectMeta.astro";
import MetaItem from "../../components/experience/MetaItem.astro";
import ProjectProse from "../../components/experience/ProjectProse.astro";
import Shot from "../../components/experience/Shot.astro";
import type { Metadata } from "../../types";

import banner from "../../assets/img/experience/ein-vaen/banner.webp";
import gameplayInventory from "../../assets/img/experience/ein-vaen/inventory.webp";
import gameplayTree from "../../assets/img/experience/ein-vaen/tree.webp";
import fish from "../../assets/img/experience/ein-vaen/fish.webp";

const meta: Metadata = {
  title: "Ein-Vaen",
  description:
    "Ein-Vaen is a post apocalyptic fishing game where you play as Peebo, a living fishing lure who dives into a derelict, post-apocalyptic lake to battle mutant fish and scavenge junk.",
};
---

<Layout {meta}>
  <div class="page-wrap">
    <ProjectHeader title="Ein-Vaen" />
    <div class="mt-8 border-2 border-ink">
      <Image alt={"Ein-Vaen title screen"} src={banner} loading="eager" />
    </div>

    <ProjectBody>
      <ProjectMeta slot="meta">
        <MetaItem label="Role">Co-Creator</MetaItem>
        <MetaItem label="Dates">June 2026 – Current</MetaItem>
        <MetaItem label="Technologies">Unreal Engine Blueprint &amp; C++</MetaItem>
        <MetaItem label="Team size">2 team members</MetaItem>
      </ProjectMeta>

      <ProjectProse>
        <h2>Gameplay</h2>

        <p class="lead">
          Ein-Vaen is a post apocalyptic fishing game where you play as Peebo, a living fishing lure who dives into a
          derelict, post-apocalyptic lake to battle mutant fish and scavenge junk.
        </p>

        <Shot>
          <Image alt={""} src={gameplayInventory} />
        </Shot>

        <h2>My role</h2>
        <p>
          As the Co-Creator and sole engineer, I implement all of Ein-Vaen's gameplay features and systems. These
          systems range from but are not limited to a weight based inventory system, state-machine driven exploration
          and turn-based combat, character controller, and a character upgrade tree.
        </p>

        <Shot>
          <Image alt={""} src={gameplayTree} />
        </Shot>
      </ProjectProse>
    </ProjectBody>
  </div>
</Layout>
