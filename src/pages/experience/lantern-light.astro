---
import { Image } from "astro:assets";
import Layout from "../../layouts/Layout.astro";
import ProjectHeader from "../../components/experience/ProjectHeader.astro";
import ProjectBody from "../../components/experience/ProjectBody.astro";
import ProjectMeta from "../../components/experience/ProjectMeta.astro";
import MetaItem from "../../components/experience/MetaItem.astro";
import ProjectProse from "../../components/experience/ProjectProse.astro";
import ProjectLinks from "../../components/experience/ProjectLinks.astro";
import ProjectLink from "../../components/experience/ProjectLink.astro";
import Shot from "../../components/experience/Shot.astro";

import type { Metadata } from "../../types";

import banner from "../../assets/img/experience/lantern-light/banner.webp";
import gameplayOne from "../../assets/img/experience/lantern-light/gameplay1.webp";

const meta: Metadata = {
  title: "Lantern Light",
  description:
    "In Lantern Light, you play as a small firefly collecting light orbs to stave off the encroaching darkness. Collect light orbs to keep your lanterns lit for as long as possible in this bullet hell-like game.",
};
---

<Layout {meta}>
  <div class="page-wrap">
    <ProjectHeader title="Lantern Light" subtitle="Godot Wild Jam #72" />
    <div class="mt-8 border-2 border-ink">
      <Image alt={"Lantern light main menu"} src={banner} loading="eager" class="w-full" />
    </div>

    <ProjectBody>
      <ProjectMeta slot="meta">
        <MetaItem label="Game Jam Length">7 days</MetaItem>
        <MetaItem label="Dates">August 2024</MetaItem>
        <MetaItem label="Technologies">Godot &amp; GDScript, Aseprite</MetaItem>
        <MetaItem label="Team size">2 team members</MetaItem>
        <ProjectLinks slot="links">
          <ProjectLink href="https://tomasii.itch.io/lantern-light" icon="simple-icons:itchdotio">
            Play on itch.io
          </ProjectLink>
          <ProjectLink href="https://github.com/TomasFishOil/Game-Jam-72-Firefly" icon="simple-icons:github">
            View source code
          </ProjectLink>
        </ProjectLinks>
      </ProjectMeta>

      <ProjectProse>
        <h2>Gameplay</h2>

        <p class="lead">
          In Lantern Light, you play as a small firefly collecting light orbs to stave off the encroaching darkness.
          Collect light orbs to keep your lanterns lit for as long as possible in this bullet hell-like game.
        </p>

        <Shot>
          <Image alt={"Gameplay of Lantern Light"} src={gameplayOne} />
        </Shot>
      </ProjectProse>
    </ProjectBody>
  </div>
</Layout>
