---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  src?: ImageMetadata;
  alt?: string;
  ratio?: number;
  width?: number;
  loading?: "lazy" | "eager";
}

const { src, alt = "", loading = "lazy" } = Astro.props;
---

<div class="banner">
  {src ? (
    <Image class="banner__img" src={src} alt={alt} densities={[1, 2]} fit="cover" loading={loading} />
  ) : (
    <div
      class="banner__placeholder"
      role={alt ? "img" : undefined}
      aria-label={alt || undefined}
      aria-hidden={alt ? undefined : "true"}
    />
  )}
</div>

<style>
  .banner {
    position: relative;
    overflow: hidden;
    line-height: 0;
    background: var(--color-ink);
  }

  .banner__img {
    display: block;
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
  }
</style>
