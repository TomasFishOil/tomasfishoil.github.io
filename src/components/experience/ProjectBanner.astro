---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  src?: ImageMetadata;
  alt?: string;
  ratio?: number;
  width?: number;
  loading?: "lazy" | "eager";
}

const { src, alt = "", ratio = 2, width = 640, loading = "lazy" } = Astro.props;
const height = Math.round(width / ratio);
---

<div class="banner" style={`aspect-ratio: ${ratio}`}>
  {src ? (
    <Image
      class="banner__img"
      src={src}
      alt={alt}
      width={width}
      height={height}
      densities={[1, 2]}
      fit="cover"
      loading={loading}
    />
  ) : (
    <div
      class="banner__placeholder"
      role={alt ? "img" : undefined}
      aria-label={alt || undefined}
      aria-hidden={alt ? undefined : "true"}
    />
  )}
</div>

<style>
  .banner {
    position: relative;
    overflow: hidden;
    line-height: 0;
    background: var(--color-ink);
  }

  .banner__img {
    display: block;
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
  }
</style>
